<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The entitlements of the Developer ID signature (scripts/dist/macos.sh), whose hardened
     runtime blocks Apple events otherwise: the app asks Terminal, through osascript, to run
     the commands the user starts. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
